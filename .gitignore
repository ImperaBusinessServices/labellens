# --- Secrets: never commit these ---
.env
.env.*
!.env.example
# Real app config (server URL + shared secret) — this repo is public, so the
# real file stays local-only; commit only Secrets.swift.example.
ios/LabelLens/Secrets.swift
*.p8
*.p12
*.cer
*.mobileprovision
*.keychain
*.keychain-db

# --- iOS / Xcode ---
# The .xcodeproj is GENERATED from ios/project.yml by XcodeGen (Keith has no
# Mac to create/maintain one by hand). It is disposable build output, so it is
# ignored — project.yml is the source of truth, and it pins the Meta SDK
# version directly (packages.*.exactVersion), so no committed Package.resolved
# is needed for reproducibility.
ios/LabelLens.xcodeproj/
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.build/
Pods/
# NOTE: do NOT ignore *.xcworkspace wholesale - that would also exclude
# LabelLens.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved,
# which pins Swift Package versions (incl. the Meta toolkit) and must be
# committed so CI builds are reproducible. User-specific bits inside a
# workspace are already covered by the xcuserdata/ and *.xcuserstate rules.
Carthage/Build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# --- CocoaPods / SPM ---
.swiftpm/

# --- Python (server/) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

