ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Shared secret the iOS app must send (as "Authorization: Bearer <secret>") so
# strangers can't hit the endpoint. Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and put the SAME value in the app (VerdictClient.swift sharedSecret).
LABELLENS_SHARED_SECRET=your-long-random-shared-secret-here
