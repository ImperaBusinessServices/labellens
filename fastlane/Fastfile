# DRAFT / Phase 1 scaffolding — NOT turnkey-ready.
#
# This Fastfile is written to match .github/workflows/ios-testflight.yml.
# It will not run successfully yet:
#   - There is no Xcode project/workspace/scheme for it to build
#     (that shows up in ios/ in a later phase).
#   - The `match` git repo referenced via ENV["MATCH_GIT_URL"] has not
#     been bootstrapped yet (see the comment block at the top of
#     .github/workflows/ios-testflight.yml for the one-time setup step).
#   - No GitHub Actions secrets exist yet for MATCH_PASSWORD,
#     APP_STORE_CONNECT_API_KEY_ID, etc.
#
# Once those three things exist, `fastlane build_release` (called by the
# GitHub Actions workflow) should build, sign, and upload a build to
# TestFlight with no further changes needed here.

default_platform(:ios)

platform :ios do
  # Shared: builds an App Store Connect API key object from env vars/secrets.
  # Using an API key (instead of an Apple ID + password + 2FA) is what
  # makes unattended CI builds possible.
  private_lane :app_store_connect_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  desc "Fetch (readonly) signing certs/profiles via fastlane match — used by every normal build"
  lane :sync_signing do
    # Auth to the private match repo is via an SSH deploy key scoped to ONLY
    # that repo (set up by the workflow's SSH step). git_url is the SSH form.
    match(
      type: "appstore",
      readonly: true, # Normal builds only CONSUME certs; bootstrap_signing creates them.
      git_url: ENV["MATCH_GIT_URL"],
      app_identifier: ["com.steelblade.labellens"]
    )
  end

  # ONE-TIME cloud bootstrap. Run this once (via the signing-bootstrap.yml
  # workflow) to create the distribution certificate + provisioning profile and
  # push them, encrypted, into the private match repo. After it succeeds, every
  # normal build uses the readonly sync_signing lane above. No Mac required:
  # this runs on a GitHub-hosted macOS runner, authenticated entirely by an App
  # Store Connect API key (no Apple ID password, no interactive 2FA).
  desc "ONE-TIME: register the App ID, enable capabilities, and create+push signing assets"
  lane :bootstrap_signing do
    app_store_connect_key

    # Ensure the App ID exists in the Developer portal AND an App Store Connect
    # record exists for TestFlight, with the Associated Domains capability the
    # app's entitlements declare (universal-link pairing callback). produce is
    # not idempotent — it raises if the app already exists — so a re-run is
    # tolerated rather than fatal.
    begin
      produce(
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
        app_identifier: "com.steelblade.labellens",
        app_name: "LabelLens",
        sku: "labellens-ios-001", # any unique-per-account string; required by produce.
        language: "en-US",
        enable_services: {
          associated_domains: "on"
        }
      )
    rescue => e
      UI.important("produce step skipped (app likely already registered): #{e.message}")
    end

    # Auth to the private match repo is via the SSH deploy key (workflow sets it
    # up). Pass the API key explicitly so match creates the cert/profile through
    # the App Store Connect API instead of trying an interactive Apple ID login.
    match(
      type: "appstore",
      readonly: false, # CREATE the cert + profile and push them to the match repo.
      git_url: ENV["MATCH_GIT_URL"],
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: ["com.steelblade.labellens"]
    )
  end

  desc "Build, sign, and upload a release build to TestFlight"
  lane :build_release do
    app_store_connect_key
    sync_signing

    # DRAFT placeholder values — fill in the real scheme name once the Xcode
    # project exists in ios/. Uses project: (not workspace:) because the plan
    # is a Swift-Package-Manager-based .xcodeproj — a standalone .xcworkspace
    # only exists with CocoaPods, which this project doesn't use. Path is
    # relative to the repo root (fastlane runs from there).
    build_app(
      project: "ios/LabelLens.xcodeproj",
      scheme: "LabelLens",
      export_method: "app-store",
      output_directory: "build",
      output_name: "LabelLens.ipa"
    )

    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
